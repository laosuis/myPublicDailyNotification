# ============================================================
# 定时任务配置
# 改完这个文件提交推送到仓库即可生效，不需要动 workflow。
# 值里有空格、#、&、? 等字符时，用英文双引号包起来。
# 以 # 开头的是注释。
# ============================================================

# 请求地址，必填，必须带 http:// 或 https://
TARGET_URL="https://knockbox.miramiao.com/api/v1/send/ch_PNZSFJP71W87JJVT24Z7V9TKYHTF7JZXMYWZQN5GZ0BZZ8FSP5E0"

# 鉴权 token，选填。留空则不发送 Authorization 头。
# ⚠️ 这里是明文，且会进 git 历史。仓库是 public 的话请保持留空，
#    改用 Settings → Secrets 里的 AUTH_TOKEN（workflow 会自动兜底读取）。
AUTH_TOKEN=""

# 请求体里 body 字段的内容，选填，留空则默认「我的内容」
PAYLOAD_BODY="git各银行还款时间，出发了吗"
